{
  "name": "react-template",
  "browserslist": [
    "extends browserslist-config-baseline"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack serve --config=webpack.config.js",
    "dev-no-update": "cross-env NODE_ENV=development webpack serve --config=webpack.config.js",
    "clean:prod": "rm -rf build && rm -rf dist && mkdir dist",
    "clean:prod:win": "rmdir /s /q build && rmdir /s /q dist && mkdir dist",
    "build:webpack": "cross-env NODE_ENV=production webpack --progress --config webpack.config.js",
    "build": "npm run clean:prod && npm run lint && npm run build:webpack",
    "build:win": "npm run clean:prod:win && npm run lint && npm run build:webpack",
    "git:commit": "cd .. && npm run git:commit",
    "git:push": "cd .. && npm run git:push",
    "git:commit:push": "cd .. && npm run git:commit:push",
    "git:merge:mirror": "cd .. && npm run git:merge:mirror",
    "reinstall": "npm run reinstall:module",
    "reinstall:module": "rm -rf node_modules && rm -f package-lock.json && npm i",
    "check:update": "npx npm-check-updates",
    "lint": "eslint src",
    "tsc": "npx tsc --noEmit",
    "publish:development": "cd .. && npm run publish:development",
    "publish:staging": "cd .. && npm run publish:staging",
    "publish:production": "cd .. && npm run publish:production",
    "pub:dev": "cd .. && npm run pub:dev",
    "pub:staging": "cd .. && npm run pub:staging",
    "pub:prod": "cd .. && npm run pub:prod",
    "pub:all": "cd .. && npm run pub:all",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.28.0",
    "@loadable/component": "^5.16.7",
    "@pdg/api": "^1.0.27",
    "@pdg/compare": "^1.0.9",
    "@pdg/data": "^1.0.9",
    "@pdg/date-time": "^1.0.6",
    "@pdg/eslint-plugin-react-hook": "^1.0.4",
    "@pdg/formatting": "^1.0.9",
    "@pdg/korean": "^1.0.4",
    "@pdg/react-hook": "^2.0.24",
    "@pdg/types": "^1.0.11",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@soda/friendly-errors-webpack-plugin": "^1.8.1",
    "@svgr/webpack": "^8.1.0",
    "@types/jest": "^30.0.0",
    "@types/loadable__component": "^5.13.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/parser": "^8.70.0",
    "axios": "^1.20.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "babel-plugin-styled-components": "^2.3.0",
    "baseline-browser-mapping": "^2.11.21",
    "browserslist-config-baseline": "^0.5.0",
    "circular-dependency-plugin": "^5.2.2",
    "classnames": "^2.5.1",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.50.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "eslint": "9.28.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-webpack-plugin": "^5.0.3",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "js-file-download": "^0.4.12",
    "mini-css-extract-plugin": "^2.10.2",
    "patch-package": "^8.0.1",
    "path": "^0.12.7",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.9.6",
    "react-router": "^7.18.3",
    "react-use-error-boundary": "^3.0.0",
    "sass": "^1.104.0",
    "sass-loader": "^17.0.1",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "styled-components": "^6.5.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "url-loader": "^4.1.1",
    "usehooks-ts": "^3.1.1",
    "webpack": "^5.110.3",
    "webpack-bundle-analyzer": "^5.3.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  }
}
